/**
 * Property-Based Tests for Right-Click Seat Deletion
 *
 * Property 2: Seat Deletion Removes Seat
 * **Validates: Requirements 8.1, 8.2, 8.3, 8.4, 12.1, 12.2, 12.3, 12.4**
 *
 * These tests verify that:
 * - Single right-click on a seat removes that seat
 * - Right-click drag across multiple seats removes all intersecting seats
 * - After deletion, remaining seats are renumbered correctly
 * - Deleting from empty grid is a no-op (no error)
 * - Numbering recalculation maintains deterministic order
 *
 * Uses AppContext state management and deletion handler logic
 */

import { describe, it, expect, beforeEach } from 'vitest';
import fc from 'fast-check';
import { render } from '@testing-library/react';
import { BrowserRouter } from 'react-router-dom';
import { AppProvider } from '../context/AppContext';
import SeatCanvas from './SeatCanvas';
import { createSeat, createGridPosition } from '../types/Seat';
import type { Seat, GridPosition } from '../types/Seat';
import type { IconConfig } from '../types/Icon';
import { CAPACITY_CONFIG_MAP, AVAILABLE_CAPACITIES } from '../constants/iconConstants';

import { getRotatedSize } from '../utils/rotationSize';

/**
 * Test helper: Render SeatCanvas with providers
 */
// function renderSeatCanvas() {
  return render(
    <AppProvider>
      <BrowserRouter>
        <SeatCanvas />
      </BrowserRouter>
    </AppProvider>
  );
// }

/**
 * Test helper: Create icon configs map
 */
function createIconConfigsMap(): Map<string, IconConfig> {
  const iconConfigs = new Map<string, IconConfig>();

  const iconDefaults: Record<number, { id: string; name: string; capacity: number }> = {
    0: { id: 'table-round-4', name: 'Round Table (4-top)', capacity: 0 },
    1: { id: 'chair-1', name: 'Chair', capacity: 1 },
    2: { id: 'loveseat-2', name: 'Loveseat', capacity: 2 },
    3: { id: 'couch-3', name: 'Couch', capacity: 3 },
  };

  for (const capacity of AVAILABLE_CAPACITIES) {
    const config = CAPACITY_CONFIG_MAP[capacity];
    const defaults = iconDefaults[capacity];
    
    iconConfigs.set(defaults.id, {
      id: defaults.id,
      capacity: defaults.capacity,
      size: config,
      name: defaults.name,
      color: '#8B4513',
      visual: {
        type: 'svg',
        content: '<rect x="0" y="0" width="1" height="1" fill="currentColor" />',
      },
    });
  }

  return iconConfigs;
}

/**
 * Test helper: Get all occupied grid positions for a seat given its size and rotation
 */
function getOccupiedGridSquares(
  position: GridPosition,
  size: { width: number; height: number }
): GridPosition[] {
  const occupied: GridPosition[] = [];
  for (let row = position.row; row < position.row + size.height; row++) {
    for (let col = position.col; col < position.col + size.width; col++) {
      occupied.push(createGridPosition(col, row));
    }
  }
  return occupied;
}

/**
 * Test helper: Check if a position overlaps with any seat
 */
function findSeatsAtPosition(
  position: GridPosition,
  seats: Seat[],
  iconConfigs: Map<string, IconConfig>
): Seat[] {
  const result: Seat[] = [];

  for (const seat of seats) {
    const iconConfig = iconConfigs.get(seat.iconId);
    if (!iconConfig) continue;

    const rotatedSize = getRotatedSize(iconConfig.size, seat.rotation);
    const occupiedSquares = getOccupiedGridSquares(seat.position, rotatedSize);

    if (
      occupiedSquares.some(
        (s) => s.col === position.col && s.row === position.row
      )
    ) {
      result.push(seat);
    }
  }

  return result;
}

/**
 * Test helper: Find all seats in a drag path
 */
function findSeatsInPath(
  path: GridPosition[],
  seats: Seat[],
  iconConfigs: Map<string, IconConfig>
): Seat[] {
  const seatsSet = new Set<string>();
  const result: Seat[] = [];

  for (const position of path) {
    const seatsAtPosition = findSeatsAtPosition(position, seats, iconConfigs);
    for (const seat of seatsAtPosition) {
      if (!seatsSet.has(seat.id)) {
        seatsSet.add(seat.id);
        result.push(seat);
      }
    }
  }

  return result;
}

/**
 * Test helper: Calculate drag path using Bresenham's algorithm
 */
function calculateDragPath(start: GridPosition, end: GridPosition): GridPosition[] {
  if (start.col === end.col && start.row === end.row) {
    return [start];
  }

  const path: GridPosition[] = [];
  const dx = Math.abs(end.col - start.col);
  const dy = Math.abs(end.row - start.row);
  const sx = start.col < end.col ? 1 : -1;
  const sy = start.row < end.row ? 1 : -1;

  let err = dx - dy;
  let col = start.col;
  let row = start.row;

  while (true) {
    path.push(createGridPosition(col, row));

    if (col === end.col && row === end.row) {
      break;
    }

    const e2 = 2 * err;

    if (e2 > -dy) {
      err -= dy;
      col += sx;
    }

    if (e2 < dx) {
      err += dx;
      row += sy;
    }
  }

  return path;
}

describe('Property-Based Tests: Right-Click Seat Deletion', () => {
  let iconConfigs: Map<string, IconConfig>;

  beforeEach(() => {
    iconConfigs = createIconConfigsMap();
  });

  /**
   * Property 2: Seat Deletion Removes Seat
   *
   * **Validates: Requirements 8.1, 8.2, 8.4**
   *
   * For ANY placed seat on the canvas, deleting it via right-click SHALL remove
   * that seat from the seat list. A subsequent query for seats at that position
   * SHALL return empty.
   *
   * Mathematical properties verified:
   * - Removal: After deletion, seat is not in list
   * - Position Query: No seats at deleted position
   * - Idempotence: Deleting same seat twice is safe (no error on second delete)
   * - Determinism: Deletion always produces same result
   *
   * Test strategy:
   * 1. Create random seats at valid positions
   * 2. For each seat, delete it using findSeatsInPath (simulating right-click detection)
   * 3. Verify seat is removed from list
   * 4. Verify no seats exist at that position anymore
   */
  it('Property 2: Seat Deletion Removes Seat - Single Click', () => {
    const property = fc.property(
      fc.oneof(...Array.from(iconConfigs.keys()).map(id => fc.constant(id))),
      fc.integer({ min: 0, max: 28 }),
      fc.integer({ min: 0, max: 18 }),
      (iconId, col, row) => {
      const iconConfig = iconConfigs.get(iconId);
      if (!iconConfig) return; // Skip if invalid

      // Create a single seat
      const position = createGridPosition(col, row);
      const seat = createSeat(iconId, position, 'down');
      const seats = [seat];

      // ====================================================================
      // Requirement 8.1: Right-click on a seat removes that seat
      // ====================================================================

      // Simulate right-click on the seat position
      const deletionPath = [seat.position];

      // Find seats in deletion path (simulating handler logic)
      const seatsToRemove = findSeatsInPath(deletionPath, seats, iconConfigs);

      // Verify that we found the seat to delete
      expect(seatsToRemove).toHaveLength(1);
      expect(seatsToRemove[0].id).toBe(seat.id);

      // Remove from seats array (simulating AppContext deletion)
      const idsToRemove = new Set(seatsToRemove.map(s => s.id));
      const remainingSeats = seats.filter(s => !idsToRemove.has(s.id));

      // ====================================================================
      // Requirement 8.4: Query for deleted position returns empty
      // ====================================================================
      // Verify seat is no longer in list
      const seatsAtDeletedPosition = findSeatsAtPosition(
        seat.position,
        remainingSeats,
        iconConfigs
      );
      expect(seatsAtDeletedPosition).toEqual([]);

      // For multi-grid seats, verify all occupied squares are empty
      const rotatedSize = getRotatedSize(iconConfig.size, seat.rotation);
      const occupiedSquares = getOccupiedGridSquares(
        seat.position,
        rotatedSize
      );

      for (const square of occupiedSquares) {
        const seatsAtSquare = findSeatsAtPosition(square, remainingSeats, iconConfigs);
        expect(seatsAtSquare).toEqual([]);
      }

      // Final verification: seat was deleted
      expect(remainingSeats).toEqual([]);
    });

    fc.assert(property, { numRuns: 100 });
  });

  /**
   * Property 2 + 6: Seat Deletion + Numbering Recalculation
   *
   * **Validates: Requirements 8.2, 8.3, 12.1, 12.2, 12.3, 12.4**
   *
   * For ANY arrangement of seats, deleting seats via drag SHALL:
   * - Remove all seats intersecting the drag path
   * - Recalculate numbering for remaining seats
   * - Maintain deterministic left-to-right, top-to-bottom ordering
   * - Handle excess paths gracefully (no-op if no seats in path)
   *
   * Mathematical properties verified:
   * - Path Coverage: All seats in path are deleted
   * - Determinism: Same path always deletes same seats
   * - Numbering Correctness: Remaining seats renumbered in order
   * - Idempotence: Deleting empty path is safe no-op
   */
  it('Property 2 + 6: Seat Deletion + Renumbering - Drag Delete', () => {
    const property = fc.property(
      fc.array(
        fc.tuple(
          fc.oneof(...Array.from(iconConfigs.keys()).map(id => fc.constant(id))),
          fc.integer({ min: 0, max: 28 }),
          fc.integer({ min: 0, max: 18 })
        ),
        { minLength: 1, maxLength: 5 }
      ),
      fc.integer({ min: 0, max: 29 }),
      fc.integer({ min: 0, max: 19 }),
      fc.integer({ min: 0, max: 29 }),
      fc.integer({ min: 0, max: 19 }),
      (placements, dragStartCol, dragStartRow, dragEndCol, dragEndRow) => {
      // Create initial seats
      const seats: Seat[] = [];
      const occupiedPositions = new Set<string>();

      for (const [iconId, col, row] of placements) {
        const iconConfig = iconConfigs.get(iconId);
        if (!iconConfig) continue;

        const position = createGridPosition(col, row);
        const occupiedSquares = getOccupiedGridSquares(position, iconConfig.size);

        const hasOverlap = occupiedSquares.some(p =>
          occupiedPositions.has(`${p.col},${p.row}`)
        );

        if (hasOverlap) continue;

        const seat = createSeat(iconId, position, 'down');
        seats.push(seat);

        occupiedSquares.forEach(p => {
          occupiedPositions.add(`${p.col},${p.row}`);
        });
      }

      if (seats.length === 0) return;

      // Calculate drag path
      const dragStart = createGridPosition(dragStartCol, dragStartRow);
      const dragEnd = createGridPosition(dragEndCol, dragEndRow);
      const dragPath = calculateDragPath(dragStart, dragEnd);

      // ====================================================================
      // Requirement 8.2: Right-click drag removes all intersecting seats
      // ====================================================================

      // Find seats in drag path
      const seatsToRemove = findSeatsInPath(dragPath, seats, iconConfigs);

      // If no seats in path, it's a no-op
      if (seatsToRemove.length === 0) {
        // Verify no error occurs with empty deletion
        const idsToRemove = new Set<string>();
        const remainingSeats = seats.filter(s => !idsToRemove.has(s.id));
        expect(remainingSeats).toEqual(seats);
        return;
      }

      // ====================================================================
      // Requirement 8.3: Recalculate numbering after deletion
      // ====================================================================

      // Remove seats
      const idsToRemove = new Set(seatsToRemove.map(s => s.id));
      const remainingSeats = seats.filter(s => !idsToRemove.has(s.id));

      // Recalculate numbering
      const renumberedSeats = [...remainingSeats].sort((a, b) => {
        if (a.position.row !== b.position.row) {
          return a.position.row - b.position.row;
        }
        return a.position.col - b.position.col;
      }).map((seat, index) => ({
        ...seat,
        number: index + 1,
      }));

      // ====================================================================
      // Requirement 12.1, 12.2: Numbering is deterministic and ordered
      // ====================================================================

      // Verify numbering starts at 1 and increments by 1
      for (let i = 0; i < renumberedSeats.length; i++) {
        expect(renumberedSeats[i].number).toBe(i + 1);
      }

      // Verify ordering is left-to-right, top-to-bottom
      for (let i = 1; i < renumberedSeats.length; i++) {
        const prev = renumberedSeats[i - 1];
        const curr = renumberedSeats[i];

        if (prev.position.row === curr.position.row) {
          // Same row: current col should be > previous col
          expect(curr.position.col).toBeGreaterThan(prev.position.col);
        } else {
          // Different row: current row should be > previous row
          expect(curr.position.row).toBeGreaterThan(prev.position.row);
        }
      }

      // Verify all deleted seats are NOT in remaining list
      for (const deletedSeat of seatsToRemove) {
        const foundInRemaining = remainingSeats.some(s => s.id === deletedSeat.id);
        expect(foundInRemaining).toBe(false);
      }

      // Verify remaining count is correct
      expect(remainingSeats.length).toBe(seats.length - seatsToRemove.length);
    });

    fc.assert(property, { numRuns: 100 });
  });

  /**
   * Edge case test: Verify no-op on empty grid squares
   * Right-clicking on empty grid should not cause errors
   */
  it('Property 2: Edge Case - No-Op on Empty Grid', () => {
    const property = fc.property(
      fc.array(
        fc.tuple(
          fc.constant('chair-1'), // Use small seats
          fc.integer({ min: 0, max: 5 }),
          fc.integer({ min: 0, max: 5 })
        ),
        { maxLength: 3 }
      ),
      fc.integer({ min: 10, max: 20 }), // Position far from seats
      fc.integer({ min: 10, max: 20 }),
      (placements, emptyCol, emptyRow) => {
      const seats: Seat[] = [];

      for (const [iconId, col, row] of placements) {
        const position = createGridPosition(col, row);
        const seat = createSeat(iconId, position, 'down');
        seats.push(seat);
      }

      // Try to delete at empty position
      const emptyPosition = createGridPosition(emptyCol, emptyRow);
      const seatsToRemove = findSeatsAtPosition(emptyPosition, seats, iconConfigs);

      // Should be empty list (no-op)
      expect(seatsToRemove).toEqual([]);

      // Verify no seats were removed
      expect(seats.length).toBeGreaterThanOrEqual(0); // Original count preserved
    });

    fc.assert(property, { numRuns: 100 });
  });

  /**
   * Edge case test: Verify multi-grid seat deletion
   * All occupied grid squares of a multi-grid seat should be cleared
   */
  it('Property 2: Edge Case - Multi-Grid Seat Deletion', () => {
    const property = fc.property(
      fc.oneof(
        fc.constant('table-round-4'),
        fc.constant('loveseat-2')
      ),
      fc.integer({ min: 0, max: 27 }),
      fc.integer({ min: 0, max: 17 }),
      (iconId, col, row) => {
      const position = createGridPosition(col, row);
      const seat = createSeat(iconId, position, 'down');
      const seats = [seat];

      const iconConfig = iconConfigs.get(iconId);
      expect(iconConfig).toBeDefined();

      if (!iconConfig) return;

      const rotatedSize = getRotatedSize(iconConfig.size, seat.rotation);
      const occupiedSquares = getOccupiedGridSquares(position, rotatedSize);

      // Verify multi-grid seat occupies multiple squares
      expect(occupiedSquares.length).toBeGreaterThanOrEqual(1);

      // Delete from any occupied square - all should be removed
      for (const square of occupiedSquares) {
        const seatsToRemove = findSeatsAtPosition(square, seats, iconConfigs);
        expect(seatsToRemove).toHaveLength(1);
        expect(seatsToRemove[0].id).toBe(seat.id);
      }

      // After deletion, no squares should have seats
      const remainingSeats: Seat[] = [];
      for (const square of occupiedSquares) {
        const seatsAtSquare = findSeatsAtPosition(square, remainingSeats, iconConfigs);
        expect(seatsAtSquare).toEqual([]);
      }
    });

    fc.assert(property, { numRuns: 100 });
  });
});

